# AgenteManiculista — variables de entorno. Copia este archivo a .env y completa los valores.
# NUNCA subas .env al repositorio. Aquí no van valores reales.

# --- General ---
# Entorno de ejecución: desarrollo | demo | produccion
ENTORNO=
# true expone la interfaz /demo con calendario simulado (no requiere credenciales de Meta/Google/Gemini)
SIMULADOR=
# Nivel de logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
# Ruta de la base SQLite (en Docker: sqlite:////data/agenda.db, en un volumen persistente)
DATABASE_URL=

# --- Capa de intención (LLM) ---
# gemini | none  (none = solo botones y palabras clave; el sistema funciona completo)
PROVEEDOR_LLM=
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo Flash-Lite (por defecto gemini-3.5-flash-lite, estable; verifica el vigente en la documentación de Gemini API)
GEMINI_MODEL=
# free | paid  — el tier gratuito usa el contenido para mejorar productos de Google; en producción usa paid
GEMINI_TIER=

# --- WhatsApp vía Baileys (sidecar Node.js; ADR-009) ---
# URL interna del sidecar (en Docker: http://sidecar:3000); nunca se expone a Internet
SIDECAR_URL=
# Secreto que usa el backend para hablar con el sidecar (Authorization: Bearer ...); genéralo largo y al azar
SIDECAR_TOKEN=
# Secreto con el que el sidecar firma (HMAC-SHA256) lo que envía al backend; el mismo valor en ambos lados
WEBHOOK_SECRET=
# Token para ver el QR de vinculación en /admin/whatsapp/qr (cabecera X-Admin-Token)
ADMIN_TOKEN=

# --- Google Calendar (cuenta de servicio) ---
# Contenido JSON de la clave de la cuenta de servicio, o ruta a un archivo montado fuera del repositorio
GOOGLE_SERVICE_ACCOUNT_JSON=
# URL HTTPS pública donde Google avisa los cambios (https://tu-dominio/webhook/calendar); vacío = modo degradado
CALENDAR_WEBHOOK_URL=
# Secreto que tú generas; Google lo devuelve en cada notificación para validarla
CALENDAR_CHANNEL_TOKEN=

# --- Demo (solo con SIMULADOR=true) ---
# Segundos que tarda el calendario simulado en crear un evento (hace visible la carrera entre dos clientas)
DEMO_RETARDO_CALENDARIO_S=
